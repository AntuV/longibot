NODE_ENV=development
PORT=3000
TWITCH_CHANNEL=longii_
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info
# Local commands use compose.dev.yaml; production uses the private Compose host.
DATABASE_URL=postgresql://longibot:longibot-local@localhost:5432/longibot
POSTGRES_DB=longibot
POSTGRES_USER=longibot
POSTGRES_PASSWORD=longibot-local
POSTGRES_VOLUME_NAME=longibot-postgres
TWITCH_REDIRECT_URI=http://localhost:5173/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TOKEN_ENCRYPTION_KEY=
RIOT_API_KEY=
# Credentials are injected at runtime. Generate TOKEN_ENCRYPTION_KEY with: openssl rand -base64 32
# Optional technical owner ID: chat permissions only; no implicit dashboard access.
# OWNER_TWITCH_USER_ID=123456789
