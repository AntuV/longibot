    "/api/admin/questions/{id}": {
      "put": {
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sin sesión"
          },
          "403": {
            "description": "Sin permisos o CSRF inválido"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "answers": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                },
                "required": [
                  "text",
                  "answers"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/admin/predictions/{id}": {
      "post": {
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sin sesión"
          },
          "403": {
            "description": "Sin permisos o CSRF inválido"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "LOCKED",
                      "RESOLVED",
                      "CANCELED"
                    ]
                  },
                  "outcome": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "session": []
          }
        ]
      }
    }
