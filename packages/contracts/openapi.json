        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "gameName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "tagLine": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16
                  },
                  "platform": {
                    "type": "string",
                    "enum": [
                      "la1",
                      "la2",
                      "na1",
                      "br1",
                      "euw1",
                      "eun1",
                      "kr",
                      "jp1",
                      "oc1",
                      "tr1",
                      "ru",
                      "ph2",
                      "sg2",
                      "th2",
                      "tw2",
                      "vn2"
                    ]
                  },
                  "region": {
                    "type": "string",
                    "enum": [
                      "americas",
                      "europe",
                      "asia",
                      "sea"
                    ]
                  }
                },
                "required": [
                  "gameName",
                  "tagLine",
                  "platform",
                  "region"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/admin/reminders": {
      "post": {
