{
  "name": "longibot",
  "version": "0.1.0",
  "description": "LongiBot infrastructure scaffold",
  "scripts": {
    "dev": "concurrently -k -n api,worker,dashboard \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:dashboard\"",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env apps/worker/src/main.ts",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts",
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc -p tsconfig.build.json",
    "build:dashboard": "vite build --config apps/dashboard/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/apps/worker/src/main.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p apps/dashboard/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run contracts:check",
    "db:generate": "drizzle-kit generate --output json",
    "db:check": "drizzle-kit check --output json",
    "db:migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "contracts:generate": "node --import tsx scripts/openapi.ts && openapi-typescript packages/contracts/openapi.json -o packages/contracts/src/generated.ts",
    "contracts:check": "node scripts/check-contracts.mjs",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "import:legacy": "node --env-file-if-exists=.env --experimental-sqlite dist/scripts/import-legacy.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntuV/longibot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AntuV/longibot/issues"
  },
  "homepage": "https://github.com/AntuV/longibot#readme",
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.11",
    "@fontsource-variable/geist": "5.3.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-fastify": "12.5.1",
    "@nestjs/serve-static": "12.1.1",
    "@nestjs/swagger": "12.1.2",
    "@tanstack/react-query": "5.108.0",
    "@twurple/api": "8.2.0",
    "@twurple/auth": "8.2.0",
    "@twurple/eventsub-http": "8.2.0",
    "@twurple/eventsub-ws": "8.2.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "dotenv": "18.0.10",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "5.12.8",
    "lucide-react": "1.75.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "concurrently": "10.0.7",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "neostandard": "0.14.1",
    "openapi-typescript": "7.13.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
